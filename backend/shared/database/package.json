{
  "name": "@jobinder/database",
  "version": "1.0.0",
  "description": "Database migrations and seeds for Jobinder",
  "main": "index.js",
  "scripts": {
    "migrate": "node -r ts-node/register migrations/run-migrations.ts",
    "migrate:up": "node -r ts-node/register migrations/run-migrations.ts up",
    "migrate:down": "node -r ts-node/register migrations/run-migrations.ts down",
    "seed": "node -r ts-node/register seeds/run-seeds.ts",
    "reset": "npm run migrate:down && npm run migrate:up && npm run seed",
    "generate": "node -r ts-node/register scripts/generate-migration.ts"
  },
  "dependencies": {
    "pg": "^8.11.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.1"
  }
}
