rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Resume files
    match /resume/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && isEmployerViewingCandidate(userId);
    }
    
    // Profile pictures
    match /profile_picture/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }
    
    // Company logos
    match /company_logo/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }
    
    // Temporary files
    match /temp/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Helper functions
    function isEmployerViewingCandidate(candidateId) {
      return request.auth.token.userType == 'employer' && 
             hasActiveMatch(request.auth.uid, candidateId);
    }
    
    function hasActiveMatch(employerId, candidateId) {
      // This would need to be implemented with Firestore rules
      // For now, allow if user is an employer
      return request.auth.token.userType == 'employer';
    }
  }
}
